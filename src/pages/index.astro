---
import Layout from '../layouts/Layout.astro';
const notes = [
  { title:'Kenapa aku bikin YukinoSec lagi?', slug:'kenapa-bikin-yukinosec-lagi', category:'Personal', date:'30 AUG 2026', excerpt:'Tempat kecil buat nyimpen hal-hal yang kupelajari, eksperimen, dan catatan yang terlalu sayang kalau hilang.' },
  { title:'Catatan pertama: mulai dari yang sederhana', slug:'catatan-pertama', category:'Meta', date:'30 AUG 2026', excerpt:'Nggak semua tulisan harus sempurna. Yang penting tersimpan, bisa dicari lagi, dan suatu hari mungkin berguna buat orang lain.' },
  { title:'Checklist sebelum publish website pribadi', slug:'checklist-publish-website', category:'Web', date:'30 AUG 2026', excerpt:'Checklist kecil untuk memastikan website pribadi sudah punya fondasi SEO, metadata, sitemap, dan performa yang cukup.' },
];
---
<Layout>
  <section class="hero">
    <div class="micro top-left">MAGNIFICENT<br /><span>TO MY BIO</span></div>
    <div class="micro top-right">Y — O — U<br /><small>writing / coding / life</small></div>

    <div class="hero-copy">
      <span class="eyebrow">WELCOME TO MY LITTLE INTERNET</span>
      <h1>Welcome<br />to my <em>notes.</em></h1>
      <p>Catatan pribadi tentang coding, web, security, anime, project, dan hal-hal random yang tiba-tiba bikin penasaran.</p>
      <div class="actions"><a class="primary" href="/notes">EXPLORE NOTES <b>↗</b></a><a class="text" href="/about">about me</a></div>
    </div>

    <div class="collage" aria-hidden="true">
      <div class="sun"></div><div class="ink-blob blob-a"></div><div class="ink-blob blob-b"></div>
      <div class="scribble s-a">✦</div><div class="scribble s-b">＋</div><div class="scribble s-c">◌</div>
      <div class="portrait-card">
        <div class="portrait-label">YUKINOSEC / 001</div>
        <div class="anime-girl"><div class="ear"></div><div class="hair-back"></div><div class="head"><i class="eye left"></i><i class="eye right"></i><i class="mouth"></i></div><div class="hair-front"></div><div class="neck"></div><div class="collar"></div><div class="torso"></div></div>
        <span class="portrait-side">STAY CURIOUS</span>
      </div>
      <div class="window">
        <div class="window-bar"><i></i><i></i><i></i><span>notes.txt</span></div>
        <div class="window-body"><small>01 — RECENT</small><strong>write it down<br />before you forget.</strong><span>⌁ YukinoSec</span></div>
      </div>
      <div class="speech">YOU<br /><b>EVERYTHING</b><br />THAT I WANT.</div>
    </div>

    <div class="vertical-note">BY YUKINOSEC · KEEP WRITING</div>
  </section>

  <section class="intro-row"><div><span class="section-kicker">01 / RECENT NOTES</span><h2>Yang baru ditulis</h2></div><a href="/notes">lihat semua ↗</a></section>
  <section class="notes-grid">
    {notes.map((note, i) => <article class:list={["note-card", i === 0 && 'featured']}>
      <div class="card-top"><span>{note.category}</span><time>{note.date}</time></div>
      <div><div class="card-number">0{i + 1}</div><h3><a href={`/notes/${note.slug}`}>{note.title}</a></h3><p>{note.excerpt}</p></div>
      <a class="read" href={`/notes/${note.slug}`}>read note <span>↗</span></a>
    </article>)}
  </section>

  <section class="statement"><span>THERE'S ALWAYS</span><strong>ONE MORE<br /><em>RABBIT HOLE.</em></strong><small>and that's the fun part.</small></section>
  <section class="footer-strip"><span>雪 YUKINOSEC</span><span>PERSONAL NOTES / DIGITAL GARDEN</span><span>2026 ↗</span></section>
</Layout>

<style>
.hero{position:relative;min-height:650px;padding:72px 0 35px;overflow:hidden}.hero-copy{position:relative;z-index:4;width:52%;padding:68px 0 35px 34px}.eyebrow,.section-kicker,.micro,.vertical-note,.portrait-label,.window-bar,.window-body small,.window-body span,.card-top,.read,.footer-strip{font-family:'DM Mono',monospace}.eyebrow{font-size:10px;letter-spacing:.16em;color:#77747a}.hero h1{font-size:clamp(66px,9vw,118px);line-height:.84;letter-spacing:-.08em;margin:22px 0 27px;font-weight:800}.hero h1 em{font-family:'Playfair Display',serif;font-weight:700;font-style:italic;color:#ee5b9e;letter-spacing:-.07em}.hero p{max-width:470px;color:#69666d;line-height:1.85;font-size:14px}.actions{display:flex;align-items:center;gap:22px;margin-top:30px}.primary{display:inline-flex;align-items:center;gap:20px;padding:14px 17px;background:#17171a;color:#fff;font:10px 'DM Mono',monospace;letter-spacing:.08em;box-shadow:4px 4px 0 #ee5b9e}.primary b{font-size:15px;font-weight:400}.text{font:11px 'DM Mono',monospace;color:#69666d;border-bottom:1px solid #aaa6a0;padding-bottom:3px}.micro{position:absolute;z-index:5;font-size:9px;letter-spacing:.2em;line-height:1.8;color:#242327}.micro span{font-size:15px;letter-spacing:.12em}.micro small{color:#99959b;font-size:7px}.top-left{left:7%;top:42px}.top-right{right:7%;top:35px;text-align:right}.vertical-note{position:absolute;right:0;bottom:150px;writing-mode:vertical-rl;font-size:8px;letter-spacing:.18em;color:#99959b;z-index:5}.collage{position:absolute;z-index:2;right:-5px;top:50px;width:55%;height:565px}.sun{position:absolute;width:300px;height:300px;border-radius:50%;right:28px;top:30px;background:#eeeae3;border:1px solid #d5d0c7}.ink-blob{position:absolute;background:#17171a}.blob-a{width:185px;height:105px;right:40px;bottom:62px;border-radius:58% 42% 52% 48%;transform:rotate(-17deg)}.blob-b{width:75px;height:75px;left:25px;top:210px;border-radius:50%;transform:rotate(18deg)}.scribble{position:absolute;z-index:6;font-family:'Playfair Display',serif;color:#ee5b9e}.s-a{left:55px;top:75px;font-size:42px}.s-b{right:315px;top:245px;font:24px 'DM Mono',monospace;color:#17171a}.s-c{right:0;top:180px;font-size:54px;color:#8b72d9}.portrait-card{position:absolute;z-index:4;right:115px;bottom:18px;width:285px;height:410px;background:#ece9e2;border:1px solid #1e1d20;box-shadow:9px 9px 0 #17171a;overflow:hidden;transform:rotate(3deg)}.portrait-label{position:absolute;left:15px;top:13px;font-size:7px;letter-spacing:.15em;color:#77747a}.portrait-side{position:absolute;right:7px;top:72px;writing-mode:vertical-rl;font:7px 'DM Mono',monospace;letter-spacing:.18em;color:#8b72d9}.anime-girl{position:absolute;left:15px;right:15px;bottom:-25px;height:365px}.hair-back{position:absolute;left:52px;top:20px;width:190px;height:250px;background:#17171a;border-radius:54% 54% 42% 42%;transform:rotate(4deg)}.ear{position:absolute;z-index:1;left:58px;top:60px;width:38px;height:46px;background:#d8a8b6;clip-path:polygon(0 0,100% 50%,0 100%)}.head{position:absolute;z-index:3;left:74px;top:54px;width:145px;height:155px;border-radius:48% 48% 46% 46%;background:#f0cfd0;transform:rotate(2deg)}.eye{position:absolute;top:68px;width:20px;height:11px;border-bottom:3px solid #17171a;border-radius:50%}.eye:after{content:'';position:absolute;width:5px;height:5px;border-radius:50%;background:#17171a;left:8px;top:4px}.eye.left{left:31px}.eye.right{right:31px}.mouth{position:absolute;width:23px;height:9px;border-bottom:2px solid #9a6578;border-radius:50%;left:61px;top:112px}.hair-front{position:absolute;z-index:4;left:65px;top:30px;width:165px;height:108px;background:#17171a;clip-path:polygon(0 0,100% 0,82% 55%,68% 37%,58% 80%,44% 42%,30% 76%,20% 38%,0 65%)}.neck{position:absolute;z-index:2;left:124px;top:198px;width:52px;height:65px;background:#e5bfc2}.collar{position:absolute;z-index:5;left:93px;top:225px;width:116px;height:44px;background:#fff;border:2px solid #17171a;clip-path:polygon(0 0,50% 100%,100% 0,83% 100%,50% 35%,17% 100%)}.torso{position:absolute;left:32px;right:22px;top:246px;height:180px;background:#17171a;border-radius:70px 70px 0 0}.window{position:absolute;z-index:7;left:0;bottom:60px;width:260px;background:#fff;border:1px solid #17171a;box-shadow:6px 6px 0 #17171a;transform:rotate(-3deg)}.window-bar{height:27px;border-bottom:1px solid #d7d3cc;display:flex;align-items:center;padding:0 10px;gap:5px;font-size:8px;color:#77747a}.window-bar i{width:6px;height:6px;border-radius:50%;background:#17171a}.window-bar span{margin-left:auto}.window-body{padding:22px 20px 24px}.window-body small{display:block;font-size:7px;color:#ee5b9e;letter-spacing:.12em;margin-bottom:10px}.window-body strong{display:block;font-size:23px;line-height:1.05;letter-spacing:-.06em}.window-body span{display:block;margin-top:18px;font-size:8px;color:#77747a}.speech{position:absolute;z-index:8;right:0;top:215px;background:#17171a;color:#fff;padding:16px 20px;font:10px 'DM Mono',monospace;line-height:1.7;transform:rotate(2deg);box-shadow:5px 5px 0 #ee5b9e}.speech b{font-size:13px;color:#ff9bc7}.intro-row{display:flex;justify-content:space-between;align-items:end;margin:30px 0 18px;padding:0 2px}.intro-row h2{font-size:31px;letter-spacing:-.05em;margin:8px 0 0}.intro-row>a{font-size:10px;color:#77747a}.notes-grid{display:grid;grid-template-columns:1.15fr 1fr 1fr;gap:14px}.note-card{min-height:285px;padding:22px;border:1px solid #d9d5cd;background:#fdfcf9;display:flex;flex-direction:column;justify-content:space-between;position:relative;transition:.2s}.note-card:hover{transform:translate(-3px,-4px);box-shadow:6px 6px 0 #17171a}.note-card.featured{background:#17171a;color:#fff;border-color:#17171a}.card-top{display:flex;justify-content:space-between;font-size:9px;color:#99959b}.card-top span{color:#ee5b9e}.featured .card-top{color:#aaa6ad}.featured .card-top span{color:#ff92c3}.card-number{font:9px 'DM Mono',monospace;color:#b1adb2;margin-bottom:13px}.note-card h3{font-size:21px;line-height:1.18;letter-spacing:-.045em;margin:0 0 12px;max-width:330px}.note-card p{color:#77747a;font-size:12px;line-height:1.75;margin:0}.featured p{color:#aaa6ad}.read{font-size:9px;color:#77747a}.featured .read{color:#d3cfd5}.read span{color:#ee5b9e;margin-left:8px}.statement{margin:85px auto 20px;max-width:850px;text-align:center;padding:55px 20px;border-top:1px solid #d9d5cd;border-bottom:1px solid #d9d5cd}.statement span{display:block;font:9px 'DM Mono',monospace;letter-spacing:.2em;color:#77747a;margin-bottom:18px}.statement strong{display:block;font-size:clamp(48px,8vw,90px);line-height:.84;letter-spacing:-.08em}.statement em{font-family:'Playfair Display',serif;color:#ee5b9e}.statement small{display:block;margin-top:20px;color:#99959b;font:10px 'DM Mono',monospace}.footer-strip{display:flex;justify-content:space-between;padding:10px 0;font-size:8px;letter-spacing:.12em;color:#77747a}.footer-strip span:first-child{color:#17171a}
@media(max-width:900px){.hero{min-height:auto;padding-top:55px}.hero-copy{width:100%;padding:45px 0 20px}.hero h1{font-size:72px}.collage{position:relative;right:auto;top:auto;width:100%;height:530px;margin-top:20px}.portrait-card{right:18%;}.window{left:2%;}.notes-grid{grid-template-columns:1fr 1fr}.note-card.featured{grid-column:1/-1}.vertical-note{display:none}}
@media(max-width:600px){.hero h1{font-size:58px}.micro{display:none}.collage{height:465px}.portrait-card{width:225px;height:335px;right:8%;bottom:22px}.anime-girl{transform:scale(.78);transform-origin:bottom center;left:-2px;right:-2px}.window{width:205px;bottom:28px}.window-body{padding:16px}.window-body strong{font-size:18px}.speech{right:-3px;top:155px;padding:11px 14px}.sun{width:230px;height:230px;right:10px}.notes-grid{grid-template-columns:1fr}.note-card.featured{grid-column:auto}.statement{margin-top:55px}.footer-strip{flex-direction:column;gap:7px}}
</style>
