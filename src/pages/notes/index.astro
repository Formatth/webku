---
import Layout from '../../layouts/Layout.astro';
const notes = [
  ['Kenapa aku bikin YukinoSec lagi?','Personal','30 Aug 2026','kenapa-bikin-yukinosec-lagi'],
  ['Catatan pertama: mulai dari yang sederhana','Meta','30 Aug 2026','catatan-pertama'],
  ['Checklist sebelum publish website pribadi','Web','30 Aug 2026','checklist-publish-website'],
];
---
<Layout title="Notes — YukinoSec" description="Arsip catatan pribadi YukinoSec tentang coding, web, security, project, anime, dan eksperimen.">
  <section class="head">
    <div class="tiny">02 / ARCHIVE · KEEP THE RECEIPTS</div>
    <h1>Notes<span>.</span></h1>
    <p>Semua catatan kecil yang sengaja disimpan supaya nggak hilang begitu saja.</p>
    <div class="stamp">NO. 02<br /><b>YUKINOSEC</b></div>
  </section>
  <div class="list">
    {notes.map(([title,category,date,slug],i)=><a class="item" href={`/notes/${slug}`}>
      <span class="num">{String(i+1).padStart(2,'0')}</span>
      <div class="item-copy"><span class="meta">{category} · {date}</span><h2>{title}</h2><p>Open note and continue reading ↗</p></div>
      <span class="arrow">↗</span>
    </a>)}
  </div>
  <div class="endmark">✦ MORE NOTES WILL GROW HERE ✦</div>
</Layout>
<style>
.head{position:relative;padding:90px 0 58px;max-width:820px}.tiny,.meta,.item-copy p,.endmark,.stamp{font:10px 'DM Mono',monospace;letter-spacing:.1em}.tiny{color:#77747a}.head h1{font-size:clamp(76px,11vw,128px);line-height:.82;letter-spacing:-.09em;margin:19px 0}.head h1 span{font-family:'Playfair Display',serif;font-style:italic;color:#ee5b9e}.head>p{max-width:570px;color:#77747a;line-height:1.85;font-size:14px}.stamp{position:absolute;right:5%;bottom:65px;border:1px solid #17171a;padding:12px 15px;transform:rotate(7deg);color:#77747a;text-align:center}.stamp b{color:#17171a;font-size:12px}.list{border-top:1px solid #17171a}.item{display:grid;grid-template-columns:75px 1fr 35px;gap:18px;align-items:center;padding:27px 8px;border-bottom:1px solid #d9d5cd;transition:.2s}.item:hover{background:#17171a;color:#fff;padding-left:18px}.num{font:12px 'DM Mono',monospace;color:#99959b}.item-copy .meta{color:#ee5b9e;font-size:9px}.item h2{font-size:clamp(22px,3vw,31px);letter-spacing:-.05em;line-height:1.08;margin:9px 0}.item-copy p{font-size:8px;color:#99959b;margin:0}.item:hover .item-copy p,.item:hover .num{color:#aaa6ad}.arrow{font-size:20px;text-align:right}.item:hover .arrow{color:#ff92c3}.endmark{text-align:center;color:#99959b;padding:35px 0 10px;font-size:8px}
@media(max-width:600px){.head{padding:58px 0 42px}.stamp{right:2%;bottom:36px;transform:scale(.8) rotate(7deg)}.item{grid-template-columns:35px 1fr 22px;gap:10px;padding:22px 4px}.item h2{font-size:19px}.arrow{font-size:16px}}
</style>
