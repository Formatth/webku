---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const { title, description, pubDate, category, tags } = note.data;
---
<Layout title={`${title} — YukinoSec`} description={description} canonical={`https://dev.yukinoshita.web.id/notes/${note.id}`}>
  <article class="post">
    <header>
      <a class="back" href="/notes">← all notes</a>
      <div class="meta"><span>{category}</span><time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'})}</time></div>
      <h1>{title}</h1>
      <p class="desc">{description}</p>
      <div class="tags">{tags.map((tag)=><span>#{tag}</span>)}</div>
    </header>
    <div class="rule"></div>
    <div class="content"><Content /></div>
  </article>
</Layout>
<style>
.post{max-width:790px;margin:0 auto;padding:72px 0}.back{font:11px 'DM Mono',monospace;color:#777482}.back:hover{color:#ff75c4}.meta{display:flex;gap:14px;margin-top:42px;font:10px 'DM Mono',monospace;color:#777482}.meta span{color:#ff75c4}.post h1{font-size:clamp(42px,7vw,70px);line-height:1.03;letter-spacing:-.06em;margin:17px 0}.desc{color:#92909e;line-height:1.8;font-size:15px;max-width:680px}.tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px}.tags span{font:10px 'DM Mono',monospace;color:#8e8998;border:1px solid var(--line);padding:6px 8px;border-radius:7px}.rule{height:1px;background:var(--line);margin:48px 0}.content{font-size:16px;line-height:1.9;color:#c2becb}.content :global(h2){font-size:26px;line-height:1.2;color:#f0edf5;margin:45px 0 12px;letter-spacing:-.03em}.content :global(h3){color:#eeeaf4}.content :global(p){margin:0 0 22px}.content :global(ul),.content :global(ol){padding-left:24px}.content :global(li){margin:7px 0}.content :global(strong){color:#f1edf7}.content :global(a){color:#ff7ac6;text-decoration:underline;text-underline-offset:3px}.content :global(code){font:13px 'DM Mono',monospace;color:#72ddff;background:rgba(93,225,255,.07);padding:2px 5px;border-radius:4px}.content :global(pre){padding:18px;border:1px solid var(--line);border-radius:12px;overflow:auto;background:#090a11}.content :global(pre code){background:none;padding:0}.content :global(blockquote){border-left:2px solid #ff65bb;margin:28px 0;padding:2px 18px;color:#9c98a7}@media(max-width:700px){.post{padding:50px 0}.rule{margin:35px 0}.content{font-size:15px}}
</style>
