---
const { title = 'YukinoSec — Personal Notes', description = 'Catatan pribadi tentang coding, web, security, anime, dan hal-hal yang sedang dipelajari.', canonical } = Astro.props;
const url = canonical ?? new URL(Astro.url.pathname, 'https://dev.yukinoshita.web.id').toString();
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#090a13" />
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <div class="noise"></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="YukinoSec home">
        <span class="brand-mark">雪</span>
        <span><strong>YukinoSec</strong><small>personal notes</small></span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/notes">Notes</a>
        <a href="/about">About</a>
      </nav>
      <a class="github" href="https://github.com/Formatth/webku" rel="noreferrer">GitHub ↗</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>雪 YukinoSec</span>
      <span>Made for notes, experiments & late-night ideas.</span>
      <span>© {new Date().getFullYear()}</span>
    </footer>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
  :root { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; color: #eeeaf7; background: #080911; color-scheme: dark; --bg:#080911; --panel:#10111c; --line:rgba(255,255,255,.09); --muted:#9b9aaa; --pink:#ff5ebc; --violet:#9b7bff; --cyan:#5de1ff; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; min-width:320px; background: radial-gradient(circle at 85% 8%, rgba(155,123,255,.12), transparent 28rem), radial-gradient(circle at 8% 35%, rgba(255,94,188,.07), transparent 24rem), var(--bg); }
  body:before { content:''; position:fixed; inset:0; pointer-events:none; opacity:.25; background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px); background-size:48px 48px; mask-image:linear-gradient(to bottom,black,transparent 85%); }
  a { color:inherit; text-decoration:none; }
  .noise { position:fixed; inset:0; pointer-events:none; opacity:.035; z-index:20; background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.7'/%3E%3C/svg%3E"); }
  .site-header { width:min(1180px,calc(100% - 32px)); margin:18px auto 0; padding:11px 13px 11px 15px; border:1px solid var(--line); background:rgba(12,13,23,.72); backdrop-filter:blur(18px); border-radius:18px; display:flex; align-items:center; gap:24px; position:relative; z-index:5; }
  .brand { display:flex; align-items:center; gap:10px; margin-right:auto; }
  .brand-mark { width:38px; height:38px; display:grid; place-items:center; border-radius:12px; background:linear-gradient(135deg,#ff5ebc,#8f72ff); box-shadow:0 0 28px rgba(255,94,188,.2); font-size:20px; }
  .brand strong,.brand small { display:block; line-height:1.1; }
  .brand small { color:var(--muted); font:11px 'DM Mono',monospace; margin-top:4px; }
  nav { display:flex; gap:7px; }
  nav a,.github { color:#b9b6c6; padding:9px 12px; border-radius:10px; font-size:13px; }
  nav a:hover,.github:hover { color:#fff; background:rgba(255,255,255,.06); }
  .github { border:1px solid var(--line); }
  main { width:min(1180px,calc(100% - 32px)); margin:0 auto; }
  .site-footer { width:min(1180px,calc(100% - 32px)); margin:80px auto 28px; padding-top:20px; border-top:1px solid var(--line); color:#6f6d7b; font:11px 'DM Mono',monospace; display:flex; justify-content:space-between; gap:18px; }
  .site-footer span:first-child { color:#bdb8cc; }
  @media(max-width:700px){ .site-header{margin-top:10px}.site-header nav{display:none}.github{padding:8px 10px}.site-footer{flex-direction:column;gap:7px;margin-top:50px} }
</style>
